Cell[BoxData[
 RowBox[{
  RowBox[{"phix174genome", "=", 
   RowBox[{
   "Import", "[", "\"\</Users/kouamano/Downloads/phiX174.fna\>\"", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.533942188160857*^9, 3.533942232426828*^9}, {
  3.533942350392268*^9, 3.533942362365855*^9}, {3.533942396945009*^9, 
  3.533942420482679*^9}, {4.0023319770735826`*^9, 4.002331993884315*^9}},
 FontSize->14,
 CellLabel->"In[5]:=",ExpressionUUID->"019b7aa8-a679-4fb3-9fc7-83bb151b482d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nucleotideToComplex", "[", "\n", "  ", "DNA_String", "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Characters", "[", "\n", "     ", 
       RowBox[{"ToUpperCase", "[", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"DNA", ",", " ", 
          RowBox[{"\"\<\\n\>\"", " ", "->", " ", "\"\<\>\""}]}], "]"}], "]"}],
        "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<A\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"\"\<G\>\"", " ", "->", " ", "I"}], ",", " ", 
        RowBox[{"\"\<C\>\"", " ", "->", " ", 
         RowBox[{"-", "I"}]}]}], "}"}]}], ")"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"_String", " ", "->", " ", "0"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.533965359094214*^9, 3.5339653629129057`*^9}},
 FontSize->14,
 CellLabel->"In[7]:=",ExpressionUUID->"7a08696b-7ba3-4dfa-a330-69b0451ef6bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"phix174genomeCpx", "=", 
    RowBox[{"nucleotideToComplex", "[", 
     RowBox[{"phix174genome", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}], "//", 
  "Length"}]], "Input",
 CellChangeTimes->{{3.533965367616993*^9, 3.533965451878565*^9}, {
  3.533966988660524*^9, 3.533966999199853*^9}},
