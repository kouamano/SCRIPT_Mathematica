 TagBox[GridBox[{
    {"\<\"A\"\>", "1"},
    {"\<\"T\"\>", 
     RowBox[{"-", "1"}]},
    {"\<\"G\"\>", "\[ImaginaryI]"},
    {"\<\"C\"\>", 
